# Copy to .env and edit:  cp .env.example .env
# .env is git-ignored. NEVER commit real secrets.

# ---- PostgreSQL ----
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# ---- Spring Boot ----
# at least 32 characters, e.g. generate with:  openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRATION_MS=86400000
# true = API enforces ADMIN / LIBRARIAN roles (recommended)
ENFORCE_ROLES=true
PASSWORD_HASH_ENDPOINT_ENABLED=false
# "docker" creates demo users admin / librarian on first start. Use "prod" to disable the demo users.
SPRING_PROFILES_ACTIVE=docker
SEED_ADMIN_PASSWORD=change-me-admin
SEED_LIBRARIAN_PASSWORD=change-me-librarian

# ---- Ports on your machine ----
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432
KAFKA_EXTERNAL_PORT=29092

# ---- AI assistant (optional; Ollama runs on your machine, not in Docker) ----
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:1b
